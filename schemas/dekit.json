{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://dekit.run/schemas/dekit.json",
  "title": "dekit project",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "kernel": {
      "oneOf": [
        { "const": "npm" },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["path"],
          "properties": {
            "path": { "type": "string" }
          }
        }
      ]
    },
    "load": {
      "type": "array",
      "items": {
        "oneOf": [
          { "type": "string" },
          {
            "type": "object",
            "additionalProperties": false,
            "required": ["file"],
            "properties": {
              "file": { "type": "string" },
              "at": { "type": "string" }
            }
          }
        ]
      }
    },
    "tasks": {
      "type": "object",
      "additionalProperties": { "$ref": "#/$defs/task" }
    },
    "defaults": {
      "$ref": "#/$defs/taskSettings",
      "unevaluatedProperties": false
    },
    "log": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "level": { "type": "string" },
        "file": { "type": "string" }
      }
    },
    "on_init": { "type": "object" },
    "on_idle": { "type": "object" }
  },
  "$defs": {
    "duration": {
      "type": "string",
      "pattern": "^[1-9][0-9]*(ms|s|m|h)$",
      "description": "At most 24h."
    },
    "argv": {
      "description": "A program and its arguments. An array is the exact argv; a string is split into words with sh quoting rules, and shell syntax in it is an error.",
      "oneOf": [
        { "type": "string", "minLength": 1 },
        { "type": "array", "items": { "type": "string" }, "minItems": 1 }
      ]
    },
    "signal": {
      "type": "string",
      "pattern": "^SIG[A-Z0-9]+$"
    },
    "taskSettings": {
      "type": "object",
      "properties": {
        "cwd": { "type": "string" },
        "env": { "type": "object" },
        "add_path": { "type": "array", "items": { "type": "string" } },
        "autostart": { "type": "boolean" },
        "autorestart": { "enum": ["never", "on-failure", "always"] },
        "stop": { "$ref": "#/$defs/stop" },
        "log": {
          "oneOf": [
            { "type": "boolean" },
            { "type": "string" },
            {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "enabled": { "type": "boolean" },
                "dir": { "type": "string" },
                "file": { "type": "string" },
                "mode": { "enum": ["append", "truncate"] },
                "append": { "type": "boolean" }
              }
            }
          ]
        },
        "scrollback_len": { "type": "integer", "minimum": 0 },
        "mouse_scroll_speed": { "type": "integer", "minimum": 0 }
      }
    },
    "stop": {
      "description": "A signal name, or an object with at most one of signal, keys, or cmd (none: the one from defaults, else SIGTERM to the process group), plus timeout.",
      "oneOf": [
        { "$ref": "#/$defs/signal" },
        {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "timeout": { "$ref": "#/$defs/duration" }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["signal"],
          "properties": {
            "signal": { "$ref": "#/$defs/signal" },
            "group": {
              "type": "boolean",
              "description": "false sends the signal to the main process only."
            },
            "timeout": { "$ref": "#/$defs/duration" }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["keys"],
          "properties": {
            "keys": { "type": "array", "items": { "type": "string" } },
            "timeout": { "$ref": "#/$defs/duration" }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["cmd"],
          "properties": {
            "cmd": { "$ref": "#/$defs/argv" },
            "timeout": { "$ref": "#/$defs/duration" }
          }
        }
      ]
    },
    "ready": {
      "description": "Exactly one check, plus timeout (and interval for polled checks).",
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["log"],
          "properties": {
            "log": { "type": "string", "minLength": 1 },
            "timeout": { "$ref": "#/$defs/duration" }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["tcp"],
          "properties": {
            "tcp": {
              "oneOf": [
                { "type": "integer", "minimum": 1, "maximum": 65535 },
                { "type": "string" }
              ]
            },
            "interval": { "$ref": "#/$defs/duration" },
            "timeout": { "$ref": "#/$defs/duration" }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["http"],
          "properties": {
            "http": { "type": "string", "pattern": "^http://" },
            "interval": { "$ref": "#/$defs/duration" },
            "timeout": { "$ref": "#/$defs/duration" }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["cmd"],
          "properties": {
            "cmd": { "$ref": "#/$defs/argv" },
            "interval": { "$ref": "#/$defs/duration" },
            "timeout": { "$ref": "#/$defs/duration" }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["file"],
          "properties": {
            "file": { "type": "string" },
            "interval": { "$ref": "#/$defs/duration" },
            "timeout": { "$ref": "#/$defs/duration" }
          }
        }
      ]
    },
    "task": {
      "type": "object",
      "allOf": [
        { "$ref": "#/$defs/taskSettings" },
        {
          "properties": {
            "label": { "type": "string" },
            "type": { "enum": ["service", "job"] },
            "cmd": { "$ref": "#/$defs/argv" },
            "script": { "type": "string", "pattern": "\\.m?js$" },
            "deps": {
              "type": "array",
              "description": "Local names are rebased by fragment mounts; prefix / to address the project root.",
              "items": { "type": "string" }
            },
            "tags": { "type": "array", "items": { "type": "string" } },
            "ready": { "$ref": "#/$defs/ready" }
          },
          "oneOf": [
            { "required": ["cmd"] },
            { "required": ["script"] }
          ]
        },
        {
          "oneOf": [
            {
              "title": "service",
              "properties": { "type": { "const": "service" } }
            },
            {
              "title": "job",
              "required": ["type"],
              "properties": {
                "type": { "const": "job" },
                "autorestart": { "enum": ["never", "on-failure"] }
              },
              "not": { "required": ["ready"] }
            }
          ]
        }
      ],
      "unevaluatedProperties": false
    }
  }
}
